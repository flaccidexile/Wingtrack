# WINGTRACK Server — Environment Variables
# Copy this file to .env and fill in your values.
#
# How to get these:
# 1. Go to https://supabase.com → Project Settings → API
# 2. Copy the Project URL and the "service_role" key (NOT the anon key)
#    The service role key bypasses RLS and is ONLY used server-side.
#    NEVER expose it in the frontend.
#
# IMPORTANT: Never commit .env to version control.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1oZ2podWRhcm5ib2d6eG1nZHBoIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDc2ODYwMSwiZXhwIjoyMTA2MzQ0NjAxfQ.-P0bmSjCiBKOcH33WGSKspjIUL1_K5RDOAJFskgmeTQ

# The JWT secret is found under: Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=nWFRzIBBleh2qcp5scynuQWHesthyZKy8jkbX+G3RbWUT0CC0B3eZeKyWxGp6uW8rty5w9ewzKZROTsiK1TwgQ==

PORT=4000
CLIENT_URL=http://localhost:5173

# ── PayMongo (SANDBOX ONLY) ───────────────────────────────────
# Get your TEST secret key from: https://dashboard.paymongo.com → Developers → API Keys
# IMPORTANT: Always use the sk_test_... key here. NEVER use sk_live_ keys in this file.
PAYMONGO_SECRET_KEY=sk_test_YOUR_TEST_KEY_HERE
